{
  "name": "cubscore",
  "private": true,
  "version": "0.0.1",
  "description": "CubScore: web-first, AI-native music notation editor, player, and practice platform",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @cubscore/web dev",
    "api": "pnpm --filter @cubscore/api dev",
    "sync": "pnpm --filter @cubscore/sync dev",
    "test": "pnpm -r test",
    "corpus": "node tools/corpus-check.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "playwright-core": "^1.49.0"
  },
  "packageManager": "pnpm@10.33.0"
}
